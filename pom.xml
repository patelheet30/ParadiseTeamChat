<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.patelheet</groupId>
    <artifactId>paradiseteamchat</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>ParadiseTeamChat</name>
    <description>High-performance team communication plugin for Paper servers</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Paper API Repository -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.10-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- SQLite JDBC Driver -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.44.1.0</version>
        </dependency>

        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Squaremap API -->
        <dependency>
            <groupId>xyz.jpenilla</groupId>
            <artifactId>squaremap-api</artifactId>
            <version>1.3.13-CUSTOM</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <profiles>
        <!-- Linux x64 only build -->
        <profile>
            <id>linux</id>
            <build>
                <finalName>${project.name}-${project.version}-linux</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>

                                        <!-- SQLite: Keep ONLY Linux/x86_64 -->
                                        <filter>
                                            <artifact>org.xerial:sqlite-jdbc</artifact>
                                            <excludes>
                                                <!-- Exclude all Windows -->
                                                <exclude>org/sqlite/native/Windows/**</exclude>
                                                <exclude>org/sqlite/native/Windows-*/**</exclude>

                                                <!-- Exclude all Mac -->
                                                <exclude>org/sqlite/native/Mac/**</exclude>

                                                <!-- Exclude FreeBSD -->
                                                <exclude>org/sqlite/native/FreeBSD/**</exclude>

                                                <!-- Exclude Linux-Musl (Alpine Linux variants) -->
                                                <exclude>org/sqlite/native/Linux-Musl/**</exclude>

                                                <!-- Exclude Linux-Android (all architectures) -->
                                                <exclude>org/sqlite/native/Linux-Android/**</exclude>

                                                <!-- Exclude standard Linux ARM variants -->
                                                <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                                <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                                <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                                <exclude>org/sqlite/native/Linux/aarch64/**</exclude>

                                                <!-- Exclude Linux x86 (32-bit) -->
                                                <exclude>org/sqlite/native/Linux/x86/**</exclude>

                                                <!-- Exclude exotic architectures -->
                                                <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                                <exclude>org/sqlite/native/Linux/ppc64le/**</exclude>
                                                <exclude>org/sqlite/native/Linux/riscv64/**</exclude>

                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows x64 only build -->
        <profile>
            <id>windows</id>
            <build>
                <finalName>${project.name}-${project.version}-windows</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>

                                        <!-- SQLite: Keep ONLY Windows/x86_64 -->
                                        <filter>
                                            <artifact>org.xerial:sqlite-jdbc</artifact>
                                            <excludes>
                                                <!-- Exclude all Linux variants -->
                                                <exclude>org/sqlite/native/Linux/**</exclude>
                                                <exclude>org/sqlite/native/Linux-*/**</exclude>

                                                <!-- Exclude all Mac -->
                                                <exclude>org/sqlite/native/Mac/**</exclude>

                                                <!-- Exclude FreeBSD -->
                                                <exclude>org/sqlite/native/FreeBSD/**</exclude>

                                                <!-- Exclude Windows x86 (32-bit) -->
                                                <exclude>org/sqlite/native/Windows/x86/**</exclude>

                                                <!-- Exclude Windows ARM -->
                                                <exclude>org/sqlite/native/Windows/arm/**</exclude>
                                                <exclude>org/sqlite/native/Windows/aarch64/**</exclude>
                                                <exclude>org/sqlite/native/Windows-*/**</exclude>

                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Universal build - all platforms -->
        <profile>
            <id>universal</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <finalName>${project.name}-${project.version}-universal</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.1</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>